<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/containerCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#E61A1A1A"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="#4D2196F3"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Controls Bar -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#80000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <!-- Model Title -->
            <TextView
                android:id="@+id/tvModelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/default_model_title"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Control 1: Interaction Mode Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeToggle"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="0dp"
                android:text="@string/mode_normal"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                app:backgroundTint="#2196F3"
                app:cornerRadius="6dp"
                app:icon="@drawable/ic_mode_normal"
                app:iconGravity="textStart"
                app:iconPadding="2dp"
                app:iconSize="12dp"
                app:iconTint="#FFFFFF" />

            <!-- Control 2: Label Visibility Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLabelToggle"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:backgroundTint="#37474F"
                app:cornerRadius="6dp"
                app:icon="@drawable/ic_label"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="14dp"
                app:iconTint="#B0BEC5" />

            <!-- Control 3: Close Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:backgroundTint="#B71C1C"
                app:cornerRadius="6dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="14dp"
                app:iconTint="#FFFFFF" />
        </LinearLayout>

        <!-- 3D Render & Label Viewport Container -->
        <FrameLayout
            android:id="@+id/viewportContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextureView
                android:id="@+id/containerTextureView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.app.a3dmodelviewer.labels.LabelOverlayView
                android:id="@+id/containerLabelOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
